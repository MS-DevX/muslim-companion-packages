[{"id":113,"city":"makkah","name":{"translated":"The Daybreak","transliterated":"Al-Falaq","codepoints":[1575,1604,1601,1604,1602]},"ayahs":5,"slug":"al-falaq","translator":"Nuri (Russian)"},[1,"Скажи: \"Ищу убежища у Господа рассвета"],[2,"от зла того, что Он сотворил,"],[3,"от зла ночного мрака, когда он застилает [мир],"],[4,"от зла дующих на узлы [колдуний],"],[5,"от зла зависти завистника\"."]]