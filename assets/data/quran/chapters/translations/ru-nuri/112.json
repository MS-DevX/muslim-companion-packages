[{"id":112,"city":"makkah","name":{"translated":"The Sincerity","transliterated":"Al-Ikhlas","codepoints":[1575,1604,1573,1582,1604,1575,1589]},"ayahs":4,"slug":"al-ikhlas","translator":"Nuri (Russian)"},[1,"Скажи: \"Он - Аллах, единый,"],[2,"Аллах вечный."],[3,"Он не родил и не был рожден,"],[4,"и нет никого, равного Ему\"."]]