[{"id":114,"city":"makkah","name":{"translated":"Mankind","transliterated":"An-Nas","codepoints":[1575,1604,1606,1575,1587]},"ayahs":6,"slug":"an-nas","translator":"Nuri (Russian)"},[1,"Скажи: \"Ищу убежища у Господа людей,"],[2,"царя людей,"],[3,"Бога людей"],[4,"от зла искусителя, исчезающего [при упоминании имени Аллаха],"],[5,"подвергающего искушению сердца живых созданий,"],[6,"как джиннов, так и людей [представляющего]\"."]]