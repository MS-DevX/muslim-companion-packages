[{"id":107,"city":"makkah","name":{"translated":"The Small kindnesses","transliterated":"Al-Ma'un","codepoints":[1575,1604,1605,1575,1593,1608,1606]},"ayahs":7,"slug":"al-maun","translator":"Nuri (Russian)"},[1,"Думал ли ты о том, кто отрицает расплату [Судного дня]?"],[2,"Это ведь тот, кто гонит сироту"],[3,"и не призывает [людей] кормить бедняков."],[4,"Горе же тем молящимся,"],[5,"которые не читают молитвы истово,"],[6,"которые лицемерят"],[7,"и запрещают подавать милостыню."]]