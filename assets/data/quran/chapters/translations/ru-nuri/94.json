[{"id":94,"city":"makkah","name":{"translated":"The Relief","transliterated":"Ash-Sharh","codepoints":[1575,1604,1588,1585,1581]},"ayahs":8,"slug":"ash-sharh","translator":"Nuri (Russian)"},[1,"Разве не раскрыли Мы твое сердце [, Мухаммад, для веры]?"],[2,"Не облегчили твою ношу,"],[3,"отягчавшую твою спину?"],[4,"Разве не возвысили Мы упоминание твоего [имени]?"],[5,"Ведь, воистину, за тягостью - облегчение;"],[6,"воистину, за тягостью - облегчение."],[7,"Когда же ты освободишься [от джихада], то обратись к [молитве]"],[8,"и устреми [помыслы] к Господу своему."]]