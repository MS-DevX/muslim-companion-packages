[{"id":1,"city":"makkah","name":{"translated":"The Opener","transliterated":"Al-Fatihah","codepoints":[1575,1604,1601,1575,1578,1581,1577]},"ayahs":7,"slug":"al-fatihah","translator":"Nuri (Russian)"},[1,"Во имя Аллаха, Милостивого, Милосердного."],[2,"Хвала Аллаху - Господу [обитателей] миров,"],[3,"милостивому, милосердному,"],[4,"властителю дня Суда!"],[5,"Тебе мы поклоняемся и к Тебе взываем о помощи:"],[6,"веди нас прямым путем,"],[7,"путем тех, которых Ты облагодетельствовал, не тех, что [подпали под Твой] гнев, и не [путем] заблудших."]]