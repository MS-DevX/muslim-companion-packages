[{"id":111,"city":"makkah","name":{"translated":"The Palm Fiber","transliterated":"Al-Masad","codepoints":[1575,1604,1605,1587,1583]},"ayahs":5,"slug":"al-masad","translator":"Shaban Brich (Turkish)"},[1,"Elleri kurusun Ebu Leheb’in, kurudu da."],[2,"Ona, malı ve kazandıkları fayda vermedi."],[3,"O, alevli bir ateşe girecektir."],[4,"Karısı da, odun taşıyıcısı…"],[5,"Boynunda hurma lifinden bir halat ile…"]]