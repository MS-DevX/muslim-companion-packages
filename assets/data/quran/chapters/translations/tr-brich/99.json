[{"id":99,"city":"madinah","name":{"translated":"The Earthquake","transliterated":"Az-Zalzalah","codepoints":[1575,1604,1586,1604,1586,1604,1577]},"ayahs":8,"slug":"az-zalzalah","translator":"Shaban Brich (Turkish)"},[1,"Yer, şiddetle sarsıldığı zaman,"],[2,"Yer, ağırlıklarını çıkardığı zaman,"],[3,"İnsan: Buna ne oluyor? dediğinde,"],[4,"O gün haberlerini anlatır."],[5,"Çünkü Rabbin ona vahyetmiştir."],[6,"O gün insanlar, amelleri kendilerine gösterilmek için bölük bölük dönerler."],[7,"Kim zerre ağırlığınca iyilik yapmışsa onu görür."],[8,"Kim de zerre ağırlığınca kötülük yapmışsa onu görür."]]