[{"id":1,"city":"makkah","name":{"translated":"The Opener","transliterated":"Al-Fatihah","codepoints":[1575,1604,1601,1575,1578,1581,1577]},"ayahs":7,"slug":"al-fatihah","translator":"Shaban Brich (Turkish)"},[1,"Rahman ve Rahim Allah’ın adıyla..."],[2,"Hamd, alemlerin Rab'bi Allah'a mahsustur."],[3,"O Rahman'dır, O Rahim'dir."],[4,"Hesap gününün hakimi Allah’a mahsustur."],[5,"Yalnız sana ibadet ederiz ve yalnız senden yardım dileriz."],[6,"Bizi doğru yola ilet."],[7,"Nimet verdiğin kimselerin yoluna. Gazaba uğrayanların ve sapanların değil."]]