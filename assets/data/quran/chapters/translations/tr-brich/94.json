[{"id":94,"city":"makkah","name":{"translated":"The Relief","transliterated":"Ash-Sharh","codepoints":[1575,1604,1588,1585,1581]},"ayahs":8,"slug":"ash-sharh","translator":"Shaban Brich (Turkish)"},[1,"Senin göğsünü ferahlatıp, genişletmedik mi?"],[2,"Yükünü üzerinden indirmedik mi?"],[3,"Ki o belini bükmüştü."],[4,"Şanını yükseltmedik mi?"],[5,"Şüphesiz her zorlukla, bir kolaylık vardır."],[6,"Her zorlukla bir kolaylık vardır."],[7,"Öyleyse boş kaldın mı hemen (ibadetle) yorul."],[8,"Yalnız Rabbine rağbet et."]]