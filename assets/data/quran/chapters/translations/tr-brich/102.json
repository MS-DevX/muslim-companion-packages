[{"id":102,"city":"makkah","name":{"translated":"The Rivalry in world increase","transliterated":"At-Takathur","codepoints":[1575,1604,1578,1603,1575,1579,1585]},"ayahs":8,"slug":"at-takathur","translator":"Shaban Brich (Turkish)"},[1,"Çoklukla övünmek sizi oyaladı."],[2,"Mezarlara (ölüp) gelinceye dek."],[3,"Hayır! İleride bileceksiniz."],[4,"Yine hayır, ileride bileceksiniz."],[5,"Hayır! Kesin bir bilgiyle bilseniz (kaçınırdınız)."],[6,"Elbette Cehennem'i görürsünüz."],[7,"Nitekim onu, yakın bir gözle göreceksiniz"],[8,"Sonra, o gün nimetlerden hesaba çekileceksiniz."]]