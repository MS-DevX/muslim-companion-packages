[{"id":100,"city":"makkah","name":{"translated":"The Courser","transliterated":"Al-'Adiyat","codepoints":[1575,1604,1593,1575,1583,1610,1575,1578]},"ayahs":11,"slug":"al-adiyat","translator":"Shaban Brich (Turkish)"},[1,"Andolsun, soluya soluya koşanlara,"],[2,"(Koşarken) kıvılcım saçanlara ,"],[3,"Sabah vakti baskın yapanlara,"],[4,"Tozu dumana katanlara,"],[5,"Topluluğun ortasına dalanlara,"],[6,"İnsan, Rabbine karşı gerçekten nankördür."],[7,"Kendisi de buna şahittir."],[8,"Şüphesiz onun mal sevgisi de çok şiddetlidir."],[9,"Bilmez mi (insan), kabirlerde bulunanların çıkarılacağı."],[10,"Kalplerdeki ortaya konduğunda,"],[11,"Şüphesiz o gün, Rableri kendilerinden haberdardır."]]