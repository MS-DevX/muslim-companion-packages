[{"id":107,"city":"makkah","name":{"translated":"The Small kindnesses","transliterated":"Al-Ma'un","codepoints":[1575,1604,1605,1575,1593,1608,1606]},"ayahs":7,"slug":"al-maun","translator":"Shaban Brich (Turkish)"},[1,"Hesap gününü yalanlayanı gördün mü?"],[2,"Yetimi itip kakan işte odur."],[3,"Düşkünü doyurmaya teşvik etmez."],[4,"Öyleyse yazıklar olsun o namaz kılanlara!"],[5,"Kıldıkları namazdan gafil olanlara,"],[6,"Gösteriş yapanlara,"],[7,"Ufak tefek (ödünç vermeye) bile engel olanlara…"]]